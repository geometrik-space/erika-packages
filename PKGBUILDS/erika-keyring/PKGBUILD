pkgname=erika-keyring
pkgver=1
pkgrel=1
pkgdesc="Erika Linux package signing keys"
arch=('any')
url="https://geometrik.space"
license=('GPL')

source=(
    erika.gpg
)

sha256sums=('SKIP')

package() {

    install -Dm644 erika.gpg \
        "$pkgdir/usr/share/pacman/keyrings/erika.gpg"

    install -Dm644 /dev/null \
        "$pkgdir/usr/share/pacman/keyrings/erika-trusted"

    install -Dm644 /dev/null \
        "$pkgdir/usr/share/pacman/keyrings/erika-revoked"

}
